{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agile-freaks:apple-tools:0.1",
  "title": "Apple Project Tool Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capabilities"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "capabilities": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "$defs": {
    "non_empty_strings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoption",
        "implementation",
        "scope",
        "recommended_when",
        "limitations",
        "guardrails",
        "fallbacks"
      ],
      "properties": {
        "adoption": {
          "enum": [
            "required",
            "recommended",
            "recommended_conditional",
            "optional",
            "forbidden"
          ]
        },
        "implementation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "kind",
            "source",
            "version",
            "revision",
            "command"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 2
            },
            "kind": {
              "enum": [
                "mcp",
                "cli",
                "service",
                "other"
              ]
            },
            "source": {
              "type": "string",
              "minLength": 5
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            },
            "revision": {
              "type": [
                "string",
                "null"
              ]
            },
            "command": {
              "type": "string",
              "minLength": 2
            }
          }
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "local_development",
              "simulator",
              "real_device",
              "ci",
              "distributed_build",
              "production"
            ]
          }
        },
        "recommended_when": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "limitations": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "guardrails": {
          "$ref": "#/$defs/non_empty_strings"
        },
        "fallbacks": {
          "$ref": "#/$defs/non_empty_strings"
        }
      }
    }
  }
}
